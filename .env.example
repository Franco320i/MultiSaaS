# Copiar a .env.local para desarrollo. Nunca subir .env.local al repositorio.

# Dominio raíz de la plataforma (sin protocolo ni puerto).
# Local: localhost · Staging: staging.tuapp.com.ar · Producción: tuapp.com.ar
ROOT_DOMAIN=localhost

# Supabase (local: `npx supabase status -o env` → API_URL y PUBLISHABLE_KEY).
# Ambas son públicas: la clave publicable solo da acceso a lo que permite RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base pública de las fotos (bucket catalog-public). Más adelante puede ser un CDN.
NEXT_PUBLIC_IMAGES_BASE_URL=http://127.0.0.1:54321/storage/v1/object/public/catalog-public

# --- Pedidos (etapa 7) ---
# Clave SECRETA de Supabase (service_role). Local: `npx supabase status -o env` → SECRET_KEY.
# Solo la importa src/lib/supabase/service.ts. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Cloudflare Turnstile. Local: claves de prueba públicas que siempre pasan.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Sal para guardar las IPs como hash (límites de frecuencia). Generar una por entorno:
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
IP_HASH_SALT=
