# Copiar a .env.local para desarrollo. Nunca subir .env.local al repositorio.

# Dominio raíz de la plataforma (sin protocolo ni puerto).
# Local: localhost · Staging: staging.tuapp.com.ar · Producción: tuapp.com.ar
ROOT_DOMAIN=localhost

# Supabase (local: `npx supabase status -o env` → API_URL y PUBLISHABLE_KEY).
# Ambas son públicas: la clave publicable solo da acceso a lo que permite RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base pública de las fotos (bucket catalog-public). Más adelante puede ser un CDN.
NEXT_PUBLIC_IMAGES_BASE_URL=http://127.0.0.1:54321/storage/v1/object/public/catalog-public
